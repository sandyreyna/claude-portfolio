# ─────────────────────────────────────────────────────────────
#  Dashboard de Marketing Intelligence — variables de entorno
#  Copia este archivo a  .env  y completa tus claves.
#  Sin claves, el dashboard funciona con datos de demostración.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor (opcional)
PORT=3000

# NewsAPI — https://newsapi.org/register  (gratis para desarrollo)
NEWS_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Reddit API (OAuth de aplicación "script") — https://www.reddit.com/prefs/apps
# Si se dejan vacías se usa el endpoint público .json de solo lectura.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google Trends no necesita clave (se obtiene vía google-trends-api).

# Hugging Face — análisis de sentimiento (opcional).
# https://huggingface.co/settings/tokens  (token de solo lectura basta)
# Sin token, el sentimiento se calcula con un léxico local ES/EN.
HF_TOKEN=
